@using Bogus

@page "/payouts"

<PageTitle>Payouts | PayChangu.NET Sample</PageTitle>

<RadzenStack Gap="1rem">
    <div>
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Payouts</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">
            Send funds to a Mobile Money wallet or bank account using PayChangu.
        </RadzenText>
    </div>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <div>
                <RadzenText TextStyle="TextStyle.Subtitle2">Payout method</RadzenText>
                <RadzenDropDown TValue="string"
                                Data="@payoutMethods"
                                @bind-Value="selectedPayoutMethod"
                                Style="width: 100%" />
            </div>

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenText TextStyle="TextStyle.Subtitle2">Amount</RadzenText>
                    <RadzenNumeric TValue="decimal"
                                   @bind-Value="amount"
                                   Min="1"
                                   Format="N2"
                                   Style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenText TextStyle="TextStyle.Subtitle2">Currency</RadzenText>
                    <RadzenDropDown TValue="PayChanguCurrency"
                                    Data="@currencies"
                                    @bind-Value="currency"
                                    Change="@OnCurrencyChanged"
                                    Style="width: 100%" />
                </RadzenColumn>
            </RadzenRow>

            @if (selectedPayoutMethod == "Mobile Money")
            {
                <RadzenText TextStyle="TextStyle.Subtitle2">Mobile Money operator</RadzenText>
                <RadzenDropDown TValue="string"
                                Data="@mobileMoneyOperators"
                                TextProperty="Name"
                                ValueProperty="RefId"
                                @bind-Value="selectedOperatorRefId"
                                Change="@OnOperatorChanged"
                                Placeholder="Select an operator"
                                Disabled="@isLoadingReferenceData"
                                Style="width: 100%" />
                @if (isLoadingReferenceData)
                {
                    <RadzenText TextStyle="TextStyle.Caption">Loading payout operators...</RadzenText>
                }
                else if (!string.IsNullOrWhiteSpace(referenceDataError))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning">@referenceDataError</RadzenAlert>
                }
                <RadzenTextBox @bind-Value="mobile"
                               Placeholder="Recipient mobile number"
                               Style="width: 100%" />
            }
            else
            {
                <RadzenText TextStyle="TextStyle.Subtitle2">Bank or payout provider</RadzenText>
                <RadzenDropDown TValue="Guid"
                                Data="@supportedBanks"
                                TextProperty="Name"
                                ValueProperty="Id"
                                @bind-Value="selectedBankId"
                                Placeholder="Select a bank or provider"
                                Disabled="@isLoadingReferenceData"
                                Style="width: 100%" />
                @if (isLoadingReferenceData)
                {
                    <RadzenText TextStyle="TextStyle.Caption">Loading supported banks...</RadzenText>
                }
                else if (!string.IsNullOrWhiteSpace(referenceDataError))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning">@referenceDataError</RadzenAlert>
                }
                <RadzenTextBox @bind-Value="bankAccountName"
                               Placeholder="Recipient account name"
                               Style="width: 100%" />
                <RadzenTextBox @bind-Value="bankAccountNumber"
                               Placeholder="Recipient account number"
                               Style="width: 100%" />
            }

            <hr/>
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem;">
                <RadzenText TextStyle="TextStyle.Subtitle2">Recipient details (optional)</RadzenText>
                <RadzenButton Text="Refresh details" Icon="refresh" Size="ButtonSize.Small"
                              Click="@GenerateTestDetails" />
            </div>
            <RadzenText TextStyle="TextStyle.Caption">Generated values are editable. Refresh to generate another set.</RadzenText>
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenTextBox @bind-Value="firstName"
                                   Placeholder="First name"
                                   Style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenTextBox @bind-Value="lastName"
                                   Placeholder="Last name"
                                   Style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn Size="12">
                    <RadzenTextBox @bind-Value="email"
                                   Placeholder="Email address"
                                   Style="width: 100%" />
                </RadzenColumn>
            </RadzenRow>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger">@errorMessage</RadzenAlert>
            }

            <div>
                <RadzenButton Text="Initiate payout"
                              Icon="send"
                              Click="@InitiatePayoutAsync"
                              Disabled="@isLoading" />
            </div>
        </RadzenStack>
    </RadzenCard>

    @if (isLoading)
    {
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.Body2">Sending payout request to PayChangu...</RadzenText>
        </RadzenCard>
    }
    else if (!string.IsNullOrWhiteSpace(chargeId))
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                @if (string.Equals(transactionStatus, "success", StringComparison.OrdinalIgnoreCase))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Success">
                        Payout initiated successfully.
                        <a href="/wallet">Check your wallet balance</a>.
                    </RadzenAlert>
                }
                else
                {
                    <RadzenAlert AlertStyle="AlertStyle.Info">
                        PayChangu processed the payout request. Check the current status below.
                        <a href="/wallet">View wallet balance</a>.
                    </RadzenAlert>
                }
                <RadzenText TextStyle="TextStyle.Subtitle2">Charge identifier</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">@chargeId</RadzenText>
                @if (!string.IsNullOrWhiteSpace(providerReference))
                {
                    <RadzenText TextStyle="TextStyle.Subtitle2">Provider reference</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2">@providerReference</RadzenText>
                }
                @if (!string.IsNullOrWhiteSpace(transactionStatus))
                {
                    <RadzenText TextStyle="TextStyle.Subtitle2">Status</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2">@transactionStatus</RadzenText>
                }
                @if (!string.IsNullOrWhiteSpace(accountDetails))
                {
                    <RadzenText TextStyle="TextStyle.Subtitle2">Recipient account</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2">@accountDetails</RadzenText>
                }
                @if (selectedPayoutMethod == "Bank Transfer")
                {
                    <RadzenButton Text="Get payout details"
                                  Icon="search"
                                  Click="@GetBankPayoutDetailsAsync"
                                  Disabled="@isLoadingPayoutDetails" />
                    @if (isLoadingPayoutDetails)
                    {
                        <RadzenText TextStyle="TextStyle.Body2">Loading payout details...</RadzenText>
                    }
                    @if (!string.IsNullOrWhiteSpace(payoutDetailsMessage))
                    {
                        <RadzenAlert AlertStyle="@(payoutDetailsSucceeded ? AlertStyle.Success : AlertStyle.Warning)">
                            @payoutDetailsMessage
                        </RadzenAlert>
                    }
                    @if (!string.IsNullOrWhiteSpace(payoutDetails))
                    {
                        <RadzenText TextStyle="TextStyle.Body2" Style="white-space: pre-line">@payoutDetails</RadzenText>
                    }
                }
            </RadzenStack>
        </RadzenCard>
    }

    <RadzenCard>
        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.H6">Bank payout transactions</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption">
                Retrieve the bank payout transactions returned on the current API page.
            </RadzenText>
            <RadzenButton Text="Get all bank payouts"
                          Icon="list"
                          Click="@GetAllBankPayoutsAsync"
                          Disabled="@isLoadingBankPayouts" />
            @if (isLoadingBankPayouts)
            {
                <RadzenText TextStyle="TextStyle.Body2">Loading bank payouts...</RadzenText>
            }
            @if (!string.IsNullOrWhiteSpace(bankPayoutListMessage))
            {
                <RadzenAlert AlertStyle="@(bankPayoutListSucceeded ? AlertStyle.Success : AlertStyle.Warning)">
                    @bankPayoutListMessage
                </RadzenAlert>
            }
            @if (bankPayouts.Count > 0)
            {
                <RadzenText TextStyle="TextStyle.Caption">
                    Page @bankPayoutCurrentPage of @bankPayoutTotalPages — @bankPayouts.Count transaction(s)
                </RadzenText>
                @foreach (var payout in bankPayouts)
                {
                    <RadzenCard Variant="Variant.Outlined">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText TextStyle="TextStyle.Subtitle2">@payout.ChargeId</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">
                                @payout.Currency @payout.Amount.ToString("N2") — @payout.Status
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption">
                                Reference: @payout.ReferenceId
                            </RadzenText>
                        </RadzenStack>
                    </RadzenCard>
                }
            }
        </RadzenStack>
    </RadzenCard>
</RadzenStack>

@code {
    [Inject] IPayChanguClient payChanguClient { get; set; } = default!;

    private readonly Faker faker = new();

    private readonly string[] payoutMethods = ["Mobile Money", "Bank Transfer"];
    private readonly PayChanguCurrency[] currencies = Enum.GetValues<PayChanguCurrency>();
    private readonly List<SupportedMobileMoneyOperator> mobileMoneyOperators = [];
    private readonly List<SupportedBank> supportedBanks = [];

    private string selectedPayoutMethod = "Mobile Money";
    private PayChanguCurrency currency = PayChanguCurrency.MWK;
    private decimal amount = 5000m;
    private string? selectedOperatorRefId;
    private Guid selectedBankId;
    private string mobile = string.Empty;
    private string bankAccountName = string.Empty;
    private string bankAccountNumber = string.Empty;
    private string firstName = string.Empty;
    private string lastName = string.Empty;
    private string email = string.Empty;
    private bool isLoading;
    private bool isLoadingReferenceData;
    private string? referenceDataError;
    private string? errorMessage;
    private string? chargeId;
    private string? providerReference;
    private string? transactionStatus;
    private string? accountDetails;
    private bool isLoadingBankPayouts;
    private bool bankPayoutListSucceeded;
    private string? bankPayoutListMessage;
    private List<BankPayoutTransaction> bankPayouts = [];
    private int bankPayoutCurrentPage;
    private int bankPayoutTotalPages;
    private bool isLoadingPayoutDetails;
    private bool payoutDetailsSucceeded;
    private string? payoutDetailsMessage;
    private string? payoutDetails;

    protected override async Task OnInitializedAsync()
    {
        await LoadReferenceDataAsync();
        GenerateTestDetails();
    }

    private void GenerateTestDetails()
    {
        firstName = faker.Name.FirstName();
        lastName = faker.Name.LastName();
        email = faker.Internet.Email();
        bankAccountName = faker.Name.FullName();
        bankAccountNumber = faker.Random.ReplaceNumbers("##########");
        mobile = GetTestMobileNumber(selectedOperatorRefId, mobileMoneyOperators);
    }

    private void OnOperatorChanged(object value)
    {
        selectedOperatorRefId = value?.ToString();
        mobile = GetTestMobileNumber(selectedOperatorRefId, mobileMoneyOperators);
    }

    private string GetTestMobileNumber(string? operatorRefId, IEnumerable<SupportedMobileMoneyOperator> operators)
    {
        var operatorName = operators.FirstOrDefault(x => x.RefId == operatorRefId)?.Name ?? string.Empty;

        if (operatorName.Contains("TNM", StringComparison.OrdinalIgnoreCase))
        {
            return "0888000000";
        }

        if (operatorName.Contains("Airtel", StringComparison.OrdinalIgnoreCase))
        {
            return "0999000000";
        }

        return faker.Random.ReplaceNumbers("09########");
    }

    private async Task OnCurrencyChanged(object value)
    {
        currency = (PayChanguCurrency)value;
        await LoadMobileMoneyOperatorsAsync();
        await LoadSupportedBanksAsync();
    }

    private async Task LoadMobileMoneyOperatorsAsync()
    {
        var response = await payChanguClient.ReferenceData.MobileMoneyOperators.GetAllAsync();

        if (response.Success && response.Result?.Data is { } operators)
        {
            mobileMoneyOperators.Clear();
            mobileMoneyOperators.AddRange(operators.Where(x =>
                x.SupportsWithdrawals &&
                string.Equals(x.SupportedCountry.Currency, currency.ToString(),
                    StringComparison.OrdinalIgnoreCase)));

            if (!mobileMoneyOperators.Any(x => x.RefId == selectedOperatorRefId))
            {
                selectedOperatorRefId = mobileMoneyOperators.FirstOrDefault()?.RefId;
            }

            mobile = GetTestMobileNumber(selectedOperatorRefId, mobileMoneyOperators);
        }
        else
        {
            referenceDataError = response.ErrorMessage ??
                "Unable to retrieve Mobile Money payout operators.";
        }
    }

    private async Task LoadReferenceDataAsync()
    {
        isLoadingReferenceData = true;
        referenceDataError = null;

        try
        {
            await LoadMobileMoneyOperatorsAsync();
            await LoadSupportedBanksAsync();
        }
        catch (HttpRequestException ex)
        {
            referenceDataError = $"Unable to retrieve payout reference data: {ex.Message}";
        }
        finally
        {
            isLoadingReferenceData = false;
        }
    }

    private async Task LoadSupportedBanksAsync()
    {
        var response = await payChanguClient.ReferenceData.Banks.GetSupportedAsync(currency);

        if (response.Success && response.Result?.Data is { } banks)
        {
            supportedBanks.Clear();
            supportedBanks.AddRange(banks);
            if (!supportedBanks.Any(x => x.Id == selectedBankId))
            {
                selectedBankId = supportedBanks.FirstOrDefault()?.Id ?? Guid.Empty;
            }
        }
        else
        {
            referenceDataError = response.ErrorMessage ??
                $"Unable to retrieve supported banks for {currency}.";
        }
    }

    private async Task GetBankPayoutDetailsAsync()
    {
        payoutDetailsMessage = null;
        payoutDetails = null;
        isLoadingPayoutDetails = true;

        try
        {
            var response = await payChanguClient.Payouts.Bank.GetDetailsAsync(chargeId!);

            if (!response.Success || response.Result?.Data is not { } data)
            {
                payoutDetailsSucceeded = false;
                payoutDetailsMessage = response.ErrorMessage ?? "Unable to retrieve bank payout details.";
                return;
            }

            payoutDetailsSucceeded = true;
            payoutDetailsMessage = "Bank payout details retrieved successfully.";
            payoutDetails =
                $"Charge ID: {data.ChargeId}\n" +
                $"Reference: {data.ReferenceId}\n" +
                $"Status: {data.Status}\n" +
                $"Amount: {data.Currency} {data.Amount:N2}\n" +
                $"Recipient: {data.RecipientAccountDetails.AccountName}\n" +
                $"Account: {data.RecipientAccountDetails.AccountNumber}\n" +
                $"Bank: {data.RecipientAccountDetails.BankName}\n" +
                $"Created: {data.CreatedAt:g}\n" +
                $"Completed: {data.CompletedAt?.ToString("g") ?? "Not completed"}";
        }
        catch (HttpRequestException ex)
        {
            payoutDetailsSucceeded = false;
            payoutDetailsMessage = $"Unable to retrieve bank payout details: {ex.Message}";
        }
        finally
        {
            isLoadingPayoutDetails = false;
        }
    }

    private async Task GetAllBankPayoutsAsync()
    {
        bankPayoutListMessage = null;
        bankPayouts.Clear();
        isLoadingBankPayouts = true;

        try
        {
            var response = await payChanguClient.Payouts.Bank.GetAllAsync();

            if (!response.Success || response.Result?.Data is not { } data)
            {
                bankPayoutListSucceeded = false;
                bankPayoutListMessage = response.ErrorMessage ?? "Unable to retrieve bank payout transactions.";
                return;
            }

            bankPayoutListSucceeded = true;
            bankPayouts.AddRange(data.Transactions);
            bankPayoutCurrentPage = data.CurrentPage;
            bankPayoutTotalPages = data.TotalPages;
            bankPayoutListMessage = bankPayouts.Count == 0
                ? "No bank payout transactions were returned on this page."
                : "Bank payout transactions retrieved successfully.";
        }
        catch (HttpRequestException ex)
        {
            bankPayoutListSucceeded = false;
            bankPayoutListMessage = $"Unable to retrieve bank payout transactions: {ex.Message}";
        }
        finally
        {
            isLoadingBankPayouts = false;
        }
    }

    private async Task InitiatePayoutAsync()
    {
        errorMessage = null;
        chargeId = null;
        providerReference = null;
        transactionStatus = null;
        accountDetails = null;

        if (amount <= 0)
        {
            errorMessage = "Enter an amount greater than zero.";
            return;
        }

        if (selectedPayoutMethod == "Mobile Money" &&
            (string.IsNullOrWhiteSpace(mobile) ||
             string.IsNullOrWhiteSpace(selectedOperatorRefId)))
        {
            errorMessage = "Select a payout operator and enter the recipient's mobile number.";
            return;
        }

        if (selectedPayoutMethod == "Bank Transfer" &&
            (selectedBankId == Guid.Empty ||
             string.IsNullOrWhiteSpace(bankAccountName) ||
             string.IsNullOrWhiteSpace(bankAccountNumber)))
        {
            errorMessage = "Select a bank or provider and enter the recipient's account details.";
            return;
        }

        isLoading = true;

        try
        {
            if (selectedPayoutMethod == "Mobile Money")
            {
                await InitiateMobileMoneyPayoutAsync();
            }
            else
            {
                await InitiateBankPayoutAsync();
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Unable to connect to PayChangu: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task InitiateMobileMoneyPayoutAsync()
    {
        var response = await payChanguClient.Payouts.MobileMoney.InitiateAsync(
            new InitiateMobileMoneyPayoutRequest
            {
                Mobile = mobile.Trim(),
                MobileMoneyOperatorRefId = selectedOperatorRefId!,
                Amount = amount,
                ChargeId = Guid.NewGuid().ToString(),
                Email = string.IsNullOrWhiteSpace(email) ? null : email.Trim(),
                FirstName = string.IsNullOrWhiteSpace(firstName) ? null : firstName.Trim(),
                LastName = string.IsNullOrWhiteSpace(lastName) ? null : lastName.Trim()
            });

        if (!response.Success || response.Result?.Data?.Transaction is not { } data)
        {
            errorMessage = response.ErrorMessage ?? "PayChangu could not initiate the Mobile Money payout.";
            return;
        }

        chargeId = data.ChargeId;
        providerReference = data.ReferenceId;
        transactionStatus = data.Status;
    }

    private async Task InitiateBankPayoutAsync()
    {
        var response = await payChanguClient.Payouts.Bank.InitiateAsync(
            new InitiateBankPayoutRequest
            {
                BankId = selectedBankId,
                Amount = amount,
                ChargeId = Guid.NewGuid().ToString(),
                BankAccountName = bankAccountName.Trim(),
                BankAccountNumber = bankAccountNumber.Trim(),
                Email = string.IsNullOrWhiteSpace(email) ? null : email.Trim(),
                FirstName = string.IsNullOrWhiteSpace(firstName) ? null : firstName.Trim(),
                LastName = string.IsNullOrWhiteSpace(lastName) ? null : lastName.Trim()
            });

        if (!response.Success || response.Result?.Data?.Transaction is not { } data)
        {
            errorMessage = response.ErrorMessage ?? "PayChangu could not initiate the bank payout.";
            return;
        }

        chargeId = data.ChargeId;
        providerReference = data.ReferenceId;
        transactionStatus = data.Status;
        accountDetails = $"{data.RecipientAccountDetails.BankName} — " +
                         $"{data.RecipientAccountDetails.AccountNumber} " +
                         $"({data.RecipientAccountDetails.AccountName})";
    }
}
