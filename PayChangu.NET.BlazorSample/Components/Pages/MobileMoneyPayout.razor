@using Bogus

@page "/payouts/mobile-money"

<PageTitle>Mobile Money Payout | PayChangu.NET Sample</PageTitle>

<RadzenStack Gap="1rem" class="sample-page">
    <div class="sample-page-header">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Mobile Money Payout</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">
            Send funds to a Mobile Money wallet using a supported withdrawal operator.
        </RadzenText>
    </div>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenText TextStyle="TextStyle.Subtitle2">Amount</RadzenText>
                    <RadzenNumeric TValue="decimal" @bind-Value="amount" Min="1" Format="N2" Style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenText TextStyle="TextStyle.Subtitle2">Currency</RadzenText>
                    <RadzenDropDown TValue="PayChanguCurrency" Data="@currencies" @bind-Value="currency"
                                    Change="@OnCurrencyChanged" Style="width: 100%" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenText TextStyle="TextStyle.Subtitle2">Mobile Money operator</RadzenText>
            <a href="/payouts/operators">View payout operators</a>
            <RadzenDropDown TValue="string" Data="@mobileMoneyOperators" TextProperty="Name" ValueProperty="RefId"
                            @bind-Value="selectedOperatorRefId" Change="@OnOperatorChanged"
                            Placeholder="Select an operator" Disabled="@isLoadingReferenceData" Style="width: 100%" />
            @if (isLoadingReferenceData)
            {
                <RadzenText TextStyle="TextStyle.Caption">Loading payout operators...</RadzenText>
            }
            else if (!string.IsNullOrWhiteSpace(referenceDataError))
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning">@referenceDataError</RadzenAlert>
            }
            <RadzenTextBox @bind-Value="mobile" Placeholder="Recipient mobile number" Style="width: 100%" />

            <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem;">
                <RadzenText TextStyle="TextStyle.Subtitle2">Recipient details (optional)</RadzenText>
                <RadzenButton Text="Refresh details" Icon="refresh" Size="ButtonSize.Small" Click="@GenerateTestDetails" />
            </div>
            <RadzenText TextStyle="TextStyle.Caption">Generated values are editable.</RadzenText>
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6"><RadzenTextBox @bind-Value="firstName" Placeholder="First name" Style="width: 100%" /></RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6"><RadzenTextBox @bind-Value="lastName" Placeholder="Last name" Style="width: 100%" /></RadzenColumn>
                <RadzenColumn Size="12"><RadzenTextBox @bind-Value="email" Placeholder="Email address" Style="width: 100%" /></RadzenColumn>
            </RadzenRow>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger">@errorMessage</RadzenAlert>
            }
            <RadzenButton Text="Initiate Mobile Money payout" Icon="send" Click="@InitiatePayoutAsync" Disabled="@isLoading" />
        </RadzenStack>
    </RadzenCard>

    @if (isLoading)
    {
        <RadzenCard><RadzenText TextStyle="TextStyle.Body2">Sending payout request to PayChangu...</RadzenText></RadzenCard>
    }
    else if (!string.IsNullOrWhiteSpace(chargeId))
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                @if (string.Equals(transactionStatus, "success", StringComparison.OrdinalIgnoreCase))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Success">Payout initiated successfully. <a href="/wallet">Check your wallet balance</a>.</RadzenAlert>
                }
                else
                {
                    <RadzenAlert AlertStyle="AlertStyle.Info">PayChangu processed the payout request. Check the current status below. <a href="/wallet">View wallet balance</a>.</RadzenAlert>
                }
                <RadzenText TextStyle="TextStyle.Subtitle2">Charge identifier</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">@chargeId</RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle2">Provider reference</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">@providerReference</RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle2">Status</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">@transactionStatus</RadzenText>
                <a href="/verify-transactions">Open Verify Transactions</a>
            </RadzenStack>
        </RadzenCard>
    }
</RadzenStack>

@code {
    [Inject] IPayChanguClient payChanguClient { get; set; } = default!;

    private readonly Faker faker = new();
    private readonly PayChanguCurrency[] currencies = Enum.GetValues<PayChanguCurrency>();
    private readonly List<SupportedMobileMoneyOperator> mobileMoneyOperators = [];
    private PayChanguCurrency currency = PayChanguCurrency.MWK;
    private decimal amount = 5000m;
    private string? selectedOperatorRefId;
    private string mobile = string.Empty;
    private string firstName = string.Empty;
    private string lastName = string.Empty;
    private string email = string.Empty;
    private string? referenceDataError;
    private string? errorMessage;
    private string? chargeId;
    private string? providerReference;
    private string? transactionStatus;
    private bool isLoading;
    private bool isLoadingReferenceData;

    protected override async Task OnInitializedAsync()
    {
        await LoadMobileMoneyOperatorsAsync();
        GenerateTestDetails();
    }

    private void GenerateTestDetails()
    {
        firstName = faker.Name.FirstName();
        lastName = faker.Name.LastName();
        email = faker.Internet.Email();
        mobile = GetTestMobileNumber(selectedOperatorRefId);
    }

    private void OnOperatorChanged(object value)
    {
        selectedOperatorRefId = value?.ToString();
        mobile = GetTestMobileNumber(selectedOperatorRefId);
    }

    private string GetTestMobileNumber(string? operatorRefId)
    {
        var operatorName = mobileMoneyOperators.FirstOrDefault(x => x.RefId == operatorRefId)?.Name ?? string.Empty;
        if (operatorName.Contains("TNM", StringComparison.OrdinalIgnoreCase)) return "0888000000";
        if (operatorName.Contains("Airtel", StringComparison.OrdinalIgnoreCase)) return "0999000000";
        return faker.Random.ReplaceNumbers("09########");
    }

    private async Task OnCurrencyChanged(object value)
    {
        currency = (PayChanguCurrency)value;
        await LoadMobileMoneyOperatorsAsync();
    }

    private async Task LoadMobileMoneyOperatorsAsync()
    {
        isLoadingReferenceData = true;
        referenceDataError = null;
        try
        {
            var response = await payChanguClient.ReferenceData.MobileMoneyOperators.GetAllAsync();
            if (response.Success && response.Result?.Data is { } operators)
            {
                mobileMoneyOperators.Clear();
                mobileMoneyOperators.AddRange(operators.Where(x =>
                    x.SupportsWithdrawals &&
                    string.Equals(x.SupportedCountry.Currency, currency.ToString(), StringComparison.OrdinalIgnoreCase)));

                if (!mobileMoneyOperators.Any(x => x.RefId == selectedOperatorRefId))
                {
                    selectedOperatorRefId = mobileMoneyOperators.FirstOrDefault()?.RefId;
                }
                mobile = GetTestMobileNumber(selectedOperatorRefId);
            }
            else
            {
                referenceDataError = response.ErrorMessage ?? "Unable to retrieve Mobile Money payout operators.";
            }
        }
        catch (HttpRequestException ex)
        {
            referenceDataError = $"Unable to retrieve payout operators: {ex.Message}";
        }
        finally
        {
            isLoadingReferenceData = false;
        }
    }

    private async Task InitiatePayoutAsync()
    {
        errorMessage = null;
        chargeId = null;
        providerReference = null;
        transactionStatus = null;

        if (amount <= 0)
        {
            errorMessage = "Enter an amount greater than zero.";
            return;
        }
        if (string.IsNullOrWhiteSpace(mobile) || string.IsNullOrWhiteSpace(selectedOperatorRefId))
        {
            errorMessage = "Select a payout operator and enter the recipient's mobile number.";
            return;
        }

        isLoading = true;
        try
        {
            var response = await payChanguClient.Payouts.MobileMoney.InitiateAsync(
                new InitiateMobileMoneyPayoutRequest
                {
                    Mobile = mobile.Trim(),
                    MobileMoneyOperatorRefId = selectedOperatorRefId!,
                    Amount = amount,
                    ChargeId = Guid.NewGuid().ToString(),
                    Email = string.IsNullOrWhiteSpace(email) ? null : email.Trim(),
                    FirstName = string.IsNullOrWhiteSpace(firstName) ? null : firstName.Trim(),
                    LastName = string.IsNullOrWhiteSpace(lastName) ? null : lastName.Trim()
                });

            if (!response.Success || response.Result?.Data?.Transaction is not { } data)
            {
                errorMessage = response.ErrorMessage ?? "PayChangu could not initiate the Mobile Money payout.";
                return;
            }
            chargeId = data.ChargeId;
            providerReference = data.ReferenceId;
            transactionStatus = data.Status;
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Unable to connect to PayChangu: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
