@page "/payouts/operators"

<PageTitle>Get Operators | PayChangu.NET Sample</PageTitle>

<RadzenStack Gap="1rem" class="sample-page">
    <div class="sample-page-header">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Get Operators</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">Retrieve Mobile Money operators that support withdrawals for a selected currency.</RadzenText>
    </div>
    <RadzenCard>
        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.Subtitle2">Currency</RadzenText>
            <RadzenDropDown TValue="PayChanguCurrency" Data="@currencies" @bind-Value="currency"
                            Change="@OnCurrencyChanged" Style="width: 100%" />
            <RadzenButton Text="Get operators" Icon="refresh" Click="@LoadOperatorsAsync" Disabled="@isLoading" />
            @if (isLoading)
            {
                <RadzenText>Loading payout operators...</RadzenText>
            }
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <RadzenAlert AlertStyle="@(succeeded ? AlertStyle.Success : AlertStyle.Warning)">@message</RadzenAlert>
            }
            @foreach (var op in operators)
            {
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Gap="0.25rem">
                        <RadzenText TextStyle="TextStyle.Subtitle2">@op.Name</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption">Reference ID: @op.RefId</RadzenText>
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenStack>
    </RadzenCard>
</RadzenStack>

@code {
    [Inject] IPayChanguClient payChanguClient { get; set; } = default!;
    private readonly PayChanguCurrency[] currencies = Enum.GetValues<PayChanguCurrency>();
    private readonly List<SupportedMobileMoneyOperator> operators = [];
    private PayChanguCurrency currency = PayChanguCurrency.MWK;
    private bool isLoading;
    private bool succeeded;
    private string? message;

    protected override Task OnInitializedAsync() => LoadOperatorsAsync();

    private async Task OnCurrencyChanged(object value)
    {
        currency = (PayChanguCurrency)value;
        await LoadOperatorsAsync();
    }

    private async Task LoadOperatorsAsync()
    {
        isLoading = true;
        message = null;
        operators.Clear();
        try
        {
            var response = await payChanguClient.ReferenceData.MobileMoneyOperators.GetAllAsync();
            if (!response.Success || response.Result?.Data is not { } data)
            {
                succeeded = false;
                message = response.ErrorMessage ?? "Unable to retrieve payout operators.";
                return;
            }
            operators.AddRange(data.Where(x => x.SupportsWithdrawals &&
                string.Equals(x.SupportedCountry.Currency, currency.ToString(), StringComparison.OrdinalIgnoreCase)));
            succeeded = true;
            message = $"{operators.Count} payout operator(s) available for {currency}.";
        }
        catch (HttpRequestException ex)
        {
            succeeded = false;
            message = $"Unable to retrieve payout operators: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
