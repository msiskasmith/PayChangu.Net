@page "/webhooks"
@using PayChangu.NET.BlazorSample.Services
@inject WebhookEventStore eventStore

<PageTitle>Webhooks | PayChangu.NET Sample</PageTitle>

<RadzenStack Gap="1rem" class="sample-page">
    <div class="sample-page-header">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Webhooks</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">
            Receive PayChangu transaction notifications and validate their signatures before processing them.
        </RadzenText>
    </div>

    <RadzenAlert AlertStyle="AlertStyle.Info">
        This sample exposes a server-side webhook endpoint. It validates the raw request body using the configured
        webhook secret, then verifies Checkout and Direct Charge payments against the PayChangu API before storing
        the event. Payout events are recorded without payment verification.
        The most recent 100 events are kept in memory and remain available when you navigate away and return.
        They are cleared when the application restarts.
    </RadzenAlert>

    <RadzenCard>
        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.H6">Webhook endpoint</RadzenText>
            <RadzenText TextStyle="TextStyle.Subtitle2">HTTP method</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1">POST</RadzenText>
            <RadzenText TextStyle="TextStyle.Subtitle2">Path</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1">/api/webhooks/paychangu</RadzenText>
            <RadzenText TextStyle="TextStyle.Subtitle2">Signature header</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1">Signature</RadzenText>
            <RadzenText TextStyle="TextStyle.Subtitle2">Response</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1">
                HTTP 200 when the signature and payload are valid; HTTP 401 for an invalid signature;
                HTTP 400 for an invalid signed payload.
            </RadzenText>
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="0.75rem">
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween">
                <RadzenText TextStyle="TextStyle.H6">Received events (@events.Count)</RadzenText>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Text="Refresh"
                                  Icon="refresh"
                                  ButtonStyle="ButtonStyle.Light"
                                  Click="@RefreshEvents" />
                    <RadzenButton Text="Clear logs"
                                  Icon="delete"
                                  ButtonStyle="ButtonStyle.Light"
                                  Click="@ClearEvents"
                                  Disabled="@(events.Count == 0)" />
                </RadzenStack>
            </RadzenStack>

            @if (events.Count == 0)
            {
                <RadzenText TextStyle="TextStyle.Body2">
                    No webhook events have been received yet. Accepted events will appear here.
                </RadzenText>
            }
            else
            {
                @foreach (var webhookEvent in events)
                {
                    <RadzenCard Variant="Variant.Outlined">
                        <RadzenStack Gap="0.75rem">
                            <RadzenStack Orientation="Orientation.Horizontal"
                                         AlignItems="AlignItems.Center"
                                         JustifyContent="JustifyContent.SpaceBetween">
                                <RadzenStack Gap="0.15rem">
                                    <RadzenText TextStyle="TextStyle.Subtitle1">
                                        @webhookEvent.EventType
                                    </RadzenText>
                                    <RadzenText TextStyle="TextStyle.Caption">
                                        Received @webhookEvent.ReceivedAt.ToLocalTime().ToString("g")
                                    </RadzenText>
                                </RadzenStack>
                                <RadzenBadge Text="@webhookEvent.Status"
                                             BadgeStyle="@(string.Equals(webhookEvent.Status, "success", StringComparison.OrdinalIgnoreCase)
                                                 ? BadgeStyle.Success
                                                 : BadgeStyle.Warning)" />
                            </RadzenStack>

                            <RadzenRow Gap="0.5rem">
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenText TextStyle="TextStyle.Caption">Transaction identifier</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body2">@webhookEvent.TransactionIdentifier</RadzenText>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenText TextStyle="TextStyle.Caption">Amount</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body2">
                                        @webhookEvent.Currency @webhookEvent.Amount.ToString("N2")
                                    </RadzenText>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenText TextStyle="TextStyle.Caption">Payment flow</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body2">@webhookEvent.PaymentFlow</RadzenText>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenText TextStyle="TextStyle.Caption">Payment method</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body2">@webhookEvent.PaymentMethod</RadzenText>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenText TextStyle="TextStyle.Caption">Payment verification</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body2">
                                        @webhookEvent.VerificationStatus
                                        @if (webhookEvent.PaymentVerified == true)
                                        {
                                            <RadzenBadge Text="Confirmed" BadgeStyle="BadgeStyle.Success" />
                                        }
                                        else if (webhookEvent.PaymentVerified == false)
                                        {
                                            <RadzenBadge Text="Not confirmed" BadgeStyle="BadgeStyle.Warning" />
                                        }
                                    </RadzenText>
                                    @if (!string.IsNullOrWhiteSpace(webhookEvent.VerificationMessage))
                                    {
                                        <RadzenText TextStyle="TextStyle.Caption">
                                            @webhookEvent.VerificationMessage
                                        </RadzenText>
                                    }
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenText TextStyle="TextStyle.Caption">Environment</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body2">@webhookEvent.Mode</RadzenText>
                                </RadzenColumn>
                            </RadzenRow>

                            <WebhookEventDetails EventId="@webhookEvent.Id" />
                        </RadzenStack>
                    </RadzenCard>
                }
            }
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.H6">Events handled</RadzenText>
            <ul>
                <li>Standard Checkout — <code>checkout.payment</code></li>
                <li>Direct Charge — <code>api.charge.payment</code></li>
                <li>Payout — <code>api.payout</code></li>
            </ul>
            <RadzenText TextStyle="TextStyle.Body2">
                Checkout and Direct Charge events are verified using the transaction identifier, payment flow,
                and payment method from the webhook. The verification response must confirm a successful status
                and match the webhook amount and currency before the sample marks a payment as confirmed.
                Payout events are stored separately and are not passed to payment verification. Raw payloads
                and signatures are not stored.
            </RadzenText>
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.H6">Local testing</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1">
                PayChangu must be able to reach your webhook URL. When running locally, expose the application
                through a secure public tunnel and use the resulting public URL with the endpoint path above.
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Body2">
                Configure the webhook secret using .NET User Secrets. Run this command from the
                sample project directory (<code>PayChangu.NET.BlazorSample</code>):
            </RadzenText>
            <RadzenAlert AlertStyle="AlertStyle.Dark"
                         ShowIcon="false"
                         AllowClose="false"
                         Variant="Variant.Flat"
                         Style="background-color: #1e1e1e; color: #ffffff; border-color: #1e1e1e;">
                <pre style="margin: 0; overflow-x: auto; color: inherit;"><code style="color: inherit; font-family: Consolas, 'Courier New', monospace;">dotnet user-secrets set "PayChangu:WebhookSecret" "&lt;your-webhook-secret&gt;"</code></pre>
            </RadzenAlert>
            <RadzenText TextStyle="TextStyle.Body2">
                The endpoint returns HTTP 503 until both the API secret key and webhook secret are configured.
            </RadzenText>
        </RadzenStack>
    </RadzenCard>
</RadzenStack>

@code {
    private IReadOnlyList<WebhookEventLogEntry> events = [];

    protected override void OnInitialized()
    {
        RefreshEvents();
    }

    private void RefreshEvents()
    {
        events = eventStore.GetRecentEvents();
    }

    private void ClearEvents()
    {
        eventStore.Clear();
        RefreshEvents();
    }
}
