@using Bogus

@page "/direct-charge/bank-transfer"

<PageTitle>Bank Transfer Direct Charge | PayChangu.NET Sample</PageTitle>

<RadzenStack Gap="1rem" class="sample-page">
    <div class="sample-page-header">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Direct Charge — Bank Transfer</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">
            Initiate a bank transfer charge and display the returned payment instructions.
        </RadzenText>
    </div>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenText TextStyle="TextStyle.Subtitle2">Amount</RadzenText>
                    <RadzenNumeric TValue="decimal" @bind-Value="amount" Min="1" Format="N2" Style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenText TextStyle="TextStyle.Subtitle2">Currency</RadzenText>
                    <RadzenDropDown TValue="PayChanguCurrency" Data="@currencies" @bind-Value="currency" Style="width: 100%" />
                </RadzenColumn>
            </RadzenRow>

            <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem;">
                <RadzenText TextStyle="TextStyle.Subtitle2">Customer details</RadzenText>
                <RadzenButton Text="Refresh details" Icon="refresh" Size="ButtonSize.Small" Click="@GenerateTestDetails" />
            </div>
            <RadzenText TextStyle="TextStyle.Caption">Generated values are editable.</RadzenText>
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenTextBox @bind-Value="mobile" Placeholder="Mobile number" Style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenTextBox @bind-Value="email" Placeholder="Email address (optional)" Style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenTextBox @bind-Value="firstName" Placeholder="First name" Style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenTextBox @bind-Value="lastName" Placeholder="Last name" Style="width: 100%" />
                </RadzenColumn>
            </RadzenRow>
            <div>
                <RadzenCheckBox TValue="bool" @bind-Value="createPermanentAccount" />
                <RadzenLabel Text="Request a permanent bank account" />
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger">@errorMessage</RadzenAlert>
            }
            <RadzenButton Text="Initiate bank transfer" Icon="account_balance" Click="@InitiateBankTransferAsync" Disabled="@isLoading" />
        </RadzenStack>
    </RadzenCard>

    @if (isLoading)
    {
        <RadzenCard><RadzenText TextStyle="TextStyle.Body2">Sending payment request to PayChangu...</RadzenText></RadzenCard>
    }
    else if (!string.IsNullOrWhiteSpace(chargeId))
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenAlert AlertStyle="AlertStyle.Info">
                    The Direct Charge request was accepted. This does not mean the customer has completed payment.
                    Verify the transaction or process its webhook before fulfilling an order.
                </RadzenAlert>
                <RadzenText TextStyle="TextStyle.Subtitle2">Charge identifier</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">@chargeId</RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle2">Provider reference</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">@providerReference</RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle2">Current status</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">@paymentStatus</RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle2">Payment instructions</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">@paymentInstructions</RadzenText>
                <a href="/direct-charge/bank-transfer/details?charge_id=@chargeId">Open Single Transaction</a>
                <a href="/verify-transactions">Open Verify Transactions</a>
            </RadzenStack>
        </RadzenCard>
    }
</RadzenStack>

@code {
    [Inject] IPayChanguClient payChanguClient { get; set; } = default!;

    private readonly Faker faker = new();
    private readonly PayChanguCurrency[] currencies = Enum.GetValues<PayChanguCurrency>();
    private PayChanguCurrency currency = PayChanguCurrency.MWK;
    private decimal amount = 5000m;
    private string mobile = string.Empty;
    private string email = string.Empty;
    private string firstName = string.Empty;
    private string lastName = string.Empty;
    private bool createPermanentAccount;
    private string? chargeId;
    private string? providerReference;
    private string? paymentStatus;
    private string? paymentInstructions;
    private string? errorMessage;
    private bool isLoading;

    protected override void OnInitialized()
    {
        GenerateTestDetails();
    }

    private void GenerateTestDetails()
    {
        firstName = faker.Name.FirstName();
        lastName = faker.Name.LastName();
        email = faker.Internet.Email();
        mobile = faker.Random.ReplaceNumbers("09########");
    }

    private async Task InitiateBankTransferAsync()
    {
        errorMessage = null;
        chargeId = null;
        providerReference = null;
        paymentStatus = null;
        paymentInstructions = null;

        if (amount <= 0)
        {
            errorMessage = "Enter an amount greater than zero.";
            return;
        }
        if (string.IsNullOrWhiteSpace(mobile) ||
            string.IsNullOrWhiteSpace(firstName) ||
            string.IsNullOrWhiteSpace(lastName))
        {
            errorMessage = "Complete the customer's mobile number, first name, and last name.";
            return;
        }

        isLoading = true;
        try
        {
            var id = Guid.NewGuid().ToString();
            var response = await payChanguClient.DirectCharges.BankTransfer.InitiateAsync(
                new InitiateBankTransferDirectChargeRequest
                {
                    Amount = amount,
                    Currency = currency,
                    ChargeId = id,
                    Email = string.IsNullOrWhiteSpace(email) ? null : email.Trim(),
                    FirstName = firstName.Trim(),
                    LastName = lastName.Trim(),
                    Mobile = mobile.Trim(),
                    CreatePermanentAccount = createPermanentAccount
                });

            if (!response.Success || response.Result?.Data is not { } data)
            {
                errorMessage = response.ErrorMessage ?? "PayChangu could not initiate the Bank Transfer Direct Charge.";
                return;
            }

            chargeId = data.Transaction.ChargeId;
            providerReference = data.Transaction.ReferenceId;
            paymentStatus = data.Transaction.Status;
            paymentInstructions = $"{data.PaymentAccountDetails.BankName} — " +
                                  $"Account: {data.PaymentAccountDetails.AccountNumber}; " +
                                  $"Name: {data.PaymentAccountDetails.AccountName}";
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Unable to connect to PayChangu: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }


}
