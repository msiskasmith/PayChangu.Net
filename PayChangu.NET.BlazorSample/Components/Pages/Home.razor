@page "/"

<PageTitle>PayChangu.NET Sample</PageTitle>

<RadzenStack Gap="1rem">
    <div>
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">
            PayChangu.NET sample
        </RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">
            Explore the PayChangu.NET SDK through practical payment integration examples.
        </RadzenText>
    </div>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <div>
                <RadzenBadge Text="SDK EXAMPLES" BadgeStyle="BadgeStyle.Info" />
                <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H2" class="rz-mt-2">
                    Getting started
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Body1">
                    Explore how PayChangu.NET brings payments, payouts, and transaction management
                    into your .NET applications. Choose an area below to get started.
                </RadzenText>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
                <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                    <RadzenStack Gap="0.75rem">
                        <RadzenIcon Icon="payments" Style="font-size: 2rem; color: var(--rz-primary);" />
                        <RadzenText TextStyle="TextStyle.H6">Payment Flows</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2">
                            Try Standard Checkout, Mobile Money, Bank Transfer, and Card Direct Charge with 3-D Secure.
                        </RadzenText>
                        <a href="/payment-flows">Explore payment flows →</a>
                    </RadzenStack>
                </RadzenCard>

                <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                    <RadzenStack Gap="0.75rem">
                        <RadzenIcon Icon="receipt_long" Style="font-size: 2rem; color: var(--rz-primary);" />
                        <RadzenText TextStyle="TextStyle.H6">Transactions</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2">
                            Verify Checkout and Direct Charge transactions and inspect their returned details.
                        </RadzenText>
                        <a href="/transactions">Explore transactions →</a>
                    </RadzenStack>
                </RadzenCard>

                <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                    <RadzenStack Gap="0.75rem">
                        <RadzenIcon Icon="account_balance_wallet" Style="font-size: 2rem; color: var(--rz-primary);" />
                        <RadzenText TextStyle="TextStyle.H6">Wallet Balance</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2">
                            Retrieve your PayChangu wallet balances and view amounts by currency.
                        </RadzenText>
                        <a href="/wallet">View wallet balances →</a>
                    </RadzenStack>
                </RadzenCard>

                <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                    <RadzenStack Gap="0.75rem">
                        <RadzenIcon Icon="send" Style="font-size: 2rem; color: var(--rz-primary);" />
                        <RadzenText TextStyle="TextStyle.H6">Payouts</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2">
                            Explore Mobile Money and bank payout initiation using supported providers.
                        </RadzenText>
                        <a href="/payouts">Explore payouts →</a>
                    </RadzenStack>
                </RadzenCard>

                <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                    <RadzenStack Gap="0.75rem">
                        <RadzenIcon Icon="webhook" Style="font-size: 2rem; color: var(--rz-primary);" />
                        <RadzenText TextStyle="TextStyle.H6">Webhooks</RadzenText>
                        <RadzenText TextStyle="Body2">
                            Validate webhook signatures and inspect accepted payment and payout events.
                        </RadzenText>
                        <a href="/webhooks">Explore webhooks →</a>
                    </RadzenStack>
                </RadzenCard>
            </div>
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.H6">Receive webhooks during local development</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2">
                PayChangu cannot send webhook requests directly to localhost. Use ngrok to expose your
                locally running sample through a public HTTPS URL.
            </RadzenText>

            <RadzenText TextStyle="TextStyle.Subtitle1">1. Install and configure ngrok</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2">
                Create an ngrok account and install the ngrok agent for your operating system.
                Follow the <a href="https://ngrok.com/download" target="_blank" rel="noopener">official ngrok installation guide</a>.
                Then add the authtoken from your ngrok dashboard:
            </RadzenText>
            <RadzenAlert AlertStyle="AlertStyle.Dark"
                         ShowIcon="false"
                         AllowClose="false"
                         Variant="Variant.Flat"
                         Style="background-color: #1e1e1e; color: #ffffff; border-color: #1e1e1e;">
                <pre style="margin: 0; overflow-x: auto; color: inherit;"><code style="color: inherit; font-family: Consolas, 'Courier New', monospace;">ngrok config add-authtoken "&lt;YOUR_NGROK_AUTHTOKEN&gt;"</code></pre>
            </RadzenAlert>

            <RadzenText TextStyle="TextStyle.Subtitle1">2. Start the sample application</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2">
                Start the Blazor sample from the sample project directory. Keep it running and note
                the HTTPS local URL printed in the terminal, including its port
                (for example, <code>https://localhost:7001</code>).
            </RadzenText>

            <RadzenText TextStyle="TextStyle.Subtitle1">3. Start the ngrok tunnel</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2">
                Open a second terminal and forward ngrok to the HTTPS URL and port used by your application.
                Replace the example port with the one shown when you started the sample:
            </RadzenText>
            <RadzenAlert AlertStyle="AlertStyle.Dark"
                         ShowIcon="false"
                         AllowClose="false"
                         Variant="Variant.Flat"
                         Style="background-color: #1e1e1e; color: #ffffff; border-color: #1e1e1e;">
                <pre style="margin: 0; overflow-x: auto; color: inherit;"><code style="color: inherit; font-family: Consolas, 'Courier New', monospace;">ngrok http https://localhost:7001</code></pre>
            </RadzenAlert>
            <RadzenText TextStyle="TextStyle.Body2">
                ngrok will display a public HTTPS forwarding address. Keep this terminal open while testing;
                closing it stops the tunnel.
            </RadzenText>

            <RadzenText TextStyle="TextStyle.Subtitle1">4. Register the webhook URL with PayChangu</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2">
                In your PayChangu dashboard, configure the webhook URL using the public HTTPS address
                provided by ngrok, followed by this endpoint path:
            </RadzenText>
            <RadzenAlert AlertStyle="AlertStyle.Dark"
                         ShowIcon="false"
                         AllowClose="false"
                         Variant="Variant.Flat"
                         Style="background-color: #1e1e1e; color: #ffffff; border-color: #1e1e1e;">
                <pre style="margin: 0; overflow-x: auto; color: inherit;"><code style="color: inherit; font-family: Consolas, 'Courier New', monospace;">https://&lt;your-ngrok-domain&gt;/api/webhooks/paychangu</code></pre>
            </RadzenAlert>
            <RadzenText TextStyle="TextStyle.Body2">
                Enable the event notifications you want to test. This sample handles Standard Checkout
                (<code>checkout.payment</code>), Direct Charge (<code>api.charge.payment</code>), and
                payout (<code>api.payout</code>) events.
            </RadzenText>

            <RadzenText TextStyle="TextStyle.Subtitle1">5. Configure the webhook secret</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2">
                Set the webhook secret provided or configured for this webhook in PayChangu. This is
                separate from your PayChangu API secret key and is used to verify the
                <code>Signature</code> header on incoming requests.
            </RadzenText>
            <RadzenAlert AlertStyle="AlertStyle.Dark"
                         ShowIcon="false"
                         AllowClose="false"
                         Variant="Variant.Flat"
                         Style="background-color: #1e1e1e; color: #ffffff; border-color: #1e1e1e;">
                <pre style="margin: 0; overflow-x: auto; color: inherit;"><code style="color: inherit; font-family: Consolas, 'Courier New', monospace;">dotnet user-secrets set "PayChangu:WebhookSecret" "&lt;your-webhook-secret&gt;"</code></pre>
            </RadzenAlert>
            <RadzenText TextStyle="TextStyle.Body2">
                Make sure this value matches the webhook secret configured in PayChangu. Restart the
                sample after changing the secret so the application loads the updated configuration.
            </RadzenText>

            <RadzenAlert AlertStyle="AlertStyle.Info"
                         ShowIcon="false"
                         AllowClose="false"
                         Variant="Variant.Flat">
                Once both the application and ngrok tunnel are running and the webhook is registered,
                trigger a test payment or payout. Open the Webhooks page to view accepted events.
            </RadzenAlert>
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="0.5rem">
            <RadzenText TextStyle="TextStyle.H6">Webhook troubleshooting</RadzenText>
            <ul>
                <li><strong>HTTP 503:</strong> The <code>PayChangu:SecretKey</code> or <code>PayChangu:WebhookSecret</code> user secret is missing. Configure both secrets and restart the sample.</li>
                <li><strong>HTTP 401:</strong> The signature could not be validated. Check that the webhook secret matches the one configured in PayChangu.</li>
                <li><strong>No events appear:</strong> Confirm the sample and ngrok are both running, the registered URL includes <code>/api/webhooks/paychangu</code>, and the relevant event is enabled in PayChangu.</li>
            </ul>
            <RadzenText TextStyle="TextStyle.Body2">
                Accepted event details are kept in memory (up to the most recent 100 events). They remain
                available when you navigate away from and return to the Webhooks page, but are cleared
                when the sample application restarts. The sample does not store raw webhook payloads
                or signatures.
            </RadzenText>
        </RadzenStack>
    </RadzenCard>

    <RadzenCard>
        <RadzenStack Gap="0.5rem">
            <RadzenText TextStyle="TextStyle.H6">Keep your credentials safe</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2">
                Do not commit API keys, webhook secrets, or ngrok authtokens to source control.
                Use .NET User Secrets for local development and use an appropriate secure configuration
                provider when deploying an application.
            </RadzenText>
        </RadzenStack>
    </RadzenCard>
</RadzenStack>
