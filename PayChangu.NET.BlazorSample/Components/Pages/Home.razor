                        <a href="/direct-charge/bank-transfer">Explore bank transfer →</a>
                    </RadzenStack>
                </RadzenCard>
                <RadzenCard Variant="Variant.Outlined" Style="height: 100%;">
                    <RadzenStack Gap="0.75rem">
