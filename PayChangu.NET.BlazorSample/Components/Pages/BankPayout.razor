@using Bogus

@page "/payouts/bank"

<PageTitle>Bank Payout | PayChangu.NET Sample</PageTitle>

<RadzenStack Gap="1rem">
    <div>
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Bank Payout</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">
            Send funds to a supported bank account, retrieve an individual payout, and list bank payout transactions.
        </RadzenText>
    </div>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenText TextStyle="TextStyle.Subtitle2">Amount</RadzenText>
                    <RadzenNumeric TValue="decimal" @bind-Value="amount" Min="1" Format="N2" Style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenText TextStyle="TextStyle.Subtitle2">Currency</RadzenText>
                    <RadzenDropDown TValue="PayChanguCurrency" Data="@currencies" @bind-Value="currency"
                                    Change="@OnCurrencyChanged" Style="width: 100%" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenText TextStyle="TextStyle.Subtitle2">Bank or payout provider</RadzenText>
            <RadzenDropDown TValue="Guid" Data="@supportedBanks" TextProperty="Name" ValueProperty="Id"
                            @bind-Value="selectedBankId" Placeholder="Select a bank or provider"
                            Disabled="@isLoadingReferenceData" Style="width: 100%" />
            @if (isLoadingReferenceData)
            {
                <RadzenText TextStyle="TextStyle.Caption">Loading supported banks...</RadzenText>
            }
            else if (!string.IsNullOrWhiteSpace(referenceDataError))
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning">@referenceDataError</RadzenAlert>
            }

            <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem;">
                <RadzenText TextStyle="TextStyle.Subtitle2">Recipient account</RadzenText>
                <RadzenButton Text="Refresh details" Icon="refresh" Size="ButtonSize.Small" Click="@GenerateTestDetails" />
            </div>
            <RadzenTextBox @bind-Value="bankAccountName" Placeholder="Recipient account name" Style="width: 100%" />
            <RadzenTextBox @bind-Value="bankAccountNumber" Placeholder="Recipient account number" Style="width: 100%" />

            <RadzenText TextStyle="TextStyle.Subtitle2">Recipient details (optional)</RadzenText>
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6"><RadzenTextBox @bind-Value="firstName" Placeholder="First name" Style="width: 100%" /></RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6"><RadzenTextBox @bind-Value="lastName" Placeholder="Last name" Style="width: 100%" /></RadzenColumn>
                <RadzenColumn Size="12"><RadzenTextBox @bind-Value="email" Placeholder="Email address" Style="width: 100%" /></RadzenColumn>
            </RadzenRow>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger">@errorMessage</RadzenAlert>
            }
            <RadzenButton Text="Initiate bank payout" Icon="send" Click="@InitiatePayoutAsync" Disabled="@isLoading" />
        </RadzenStack>
    </RadzenCard>

    @if (isLoading)
    {
        <RadzenCard><RadzenText TextStyle="TextStyle.Body2">Sending payout request to PayChangu...</RadzenText></RadzenCard>
    }
    else if (!string.IsNullOrWhiteSpace(chargeId))
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                @if (string.Equals(transactionStatus, "success", StringComparison.OrdinalIgnoreCase))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Success">Payout initiated successfully. <a href="/wallet">Check your wallet balance</a>.</RadzenAlert>
                }
                else
                {
                    <RadzenAlert AlertStyle="AlertStyle.Info">PayChangu processed the payout request. Check the current status below. <a href="/wallet">View wallet balance</a>.</RadzenAlert>
                }
                <RadzenText TextStyle="TextStyle.Subtitle2">Charge identifier</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">@chargeId</RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle2">Provider reference</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">@providerReference</RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle2">Status</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">@transactionStatus</RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle2">Recipient account</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">@accountDetails</RadzenText>
                <RadzenButton Text="Get payout details" Icon="search" Click="@GetBankPayoutDetailsAsync" Disabled="@isLoadingPayoutDetails" />
                @if (isLoadingPayoutDetails)
                {
                    <RadzenText TextStyle="TextStyle.Body2">Loading payout details...</RadzenText>
                }
                @if (!string.IsNullOrWhiteSpace(payoutDetailsMessage))
                {
                    <RadzenAlert AlertStyle="@(payoutDetailsSucceeded ? AlertStyle.Success : AlertStyle.Warning)">@payoutDetailsMessage</RadzenAlert>
                }
                @if (!string.IsNullOrWhiteSpace(payoutDetails))
                {
                    <RadzenText TextStyle="TextStyle.Body2" Style="white-space: pre-line">@payoutDetails</RadzenText>
                }
                <a href="/verify-transactions">Open Verify Transactions</a>
            </RadzenStack>
        </RadzenCard>
    }

    <RadzenCard>
        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.H6">All bank payout details</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption">Retrieve the bank payout transactions returned on the current API page.</RadzenText>
            <RadzenButton Text="Get all bank payouts" Icon="list" Click="@GetAllBankPayoutsAsync" Disabled="@isLoadingBankPayouts" />
            @if (isLoadingBankPayouts)
            {
                <RadzenText TextStyle="TextStyle.Body2">Loading bank payouts...</RadzenText>
            }
            @if (!string.IsNullOrWhiteSpace(bankPayoutListMessage))
            {
                <RadzenAlert AlertStyle="@(bankPayoutListSucceeded ? AlertStyle.Success : AlertStyle.Warning)">@bankPayoutListMessage</RadzenAlert>
            }
            @if (bankPayouts.Count > 0)
            {
                <RadzenText TextStyle="TextStyle.Caption">Page @bankPayoutCurrentPage of @bankPayoutTotalPages — @bankPayouts.Count transaction(s)</RadzenText>
                @foreach (var payout in bankPayouts)
                {
                    <RadzenCard Variant="Variant.Outlined">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText TextStyle="TextStyle.Subtitle2">@payout.ChargeId</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@payout.Currency @payout.Amount.ToString("N2") — @payout.Status</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption">Reference: @payout.ReferenceId</RadzenText>
                        </RadzenStack>
                    </RadzenCard>
                }
            }
        </RadzenStack>
    </RadzenCard>
</RadzenStack>

@code {
    [Inject] IPayChanguClient payChanguClient { get; set; } = default!;

    private readonly Faker faker = new();
    private readonly PayChanguCurrency[] currencies = Enum.GetValues<PayChanguCurrency>();
    private readonly List<SupportedBank> supportedBanks = [];
    private PayChanguCurrency currency = PayChanguCurrency.MWK;
    private decimal amount = 5000m;
    private Guid selectedBankId;
    private string bankAccountName = string.Empty;
    private string bankAccountNumber = string.Empty;
    private string firstName = string.Empty;
    private string lastName = string.Empty;
    private string email = string.Empty;
    private string? referenceDataError;
    private string? errorMessage;
    private string? chargeId;
    private string? providerReference;
    private string? transactionStatus;
    private string? accountDetails;
    private string? payoutDetailsMessage;
    private string? payoutDetails;
    private bool payoutDetailsSucceeded;
    private bool isLoading;
    private bool isLoadingReferenceData;
    private bool isLoadingPayoutDetails;
    private bool isLoadingBankPayouts;
    private bool bankPayoutListSucceeded;
    private string? bankPayoutListMessage;
    private List<BankPayoutTransaction> bankPayouts = [];
    private int bankPayoutCurrentPage;
    private int bankPayoutTotalPages;

    protected override async Task OnInitializedAsync()
    {
        await LoadSupportedBanksAsync();
        GenerateTestDetails();
    }

    private void GenerateTestDetails()
    {
        firstName = faker.Name.FirstName();
        lastName = faker.Name.LastName();
        email = faker.Internet.Email();
        bankAccountName = faker.Name.FullName();
        bankAccountNumber = faker.Random.ReplaceNumbers("##########");
    }

    private async Task OnCurrencyChanged(object value)
    {
        currency = (PayChanguCurrency)value;
        await LoadSupportedBanksAsync();
    }

    private async Task LoadSupportedBanksAsync()
    {
        isLoadingReferenceData = true;
        referenceDataError = null;
        try
        {
            var response = await payChanguClient.ReferenceData.Banks.GetSupportedAsync(currency);
            if (response.Success && response.Result?.Data is { } banks)
            {
                supportedBanks.Clear();
                supportedBanks.AddRange(banks);
                if (!supportedBanks.Any(x => x.Id == selectedBankId))
                {
                    selectedBankId = supportedBanks.FirstOrDefault()?.Id ?? Guid.Empty;
                }
            }
            else
            {
                referenceDataError = response.ErrorMessage ?? $"Unable to retrieve supported banks for {currency}.";
            }
        }
        catch (HttpRequestException ex)
        {
            referenceDataError = $"Unable to retrieve supported banks: {ex.Message}";
        }
        finally
        {
            isLoadingReferenceData = false;
        }
    }

    private async Task InitiatePayoutAsync()
    {
        errorMessage = null;
        chargeId = null;
        providerReference = null;
        transactionStatus = null;
        accountDetails = null;
        payoutDetails = null;
        payoutDetailsMessage = null;

        if (amount <= 0)
        {
            errorMessage = "Enter an amount greater than zero.";
            return;
        }
        if (selectedBankId == Guid.Empty || string.IsNullOrWhiteSpace(bankAccountName) || string.IsNullOrWhiteSpace(bankAccountNumber))
        {
            errorMessage = "Select a bank or provider and enter the recipient's account details.";
            return;
        }

        isLoading = true;
        try
        {
            var response = await payChanguClient.Payouts.Bank.InitiateAsync(
                new InitiateBankPayoutRequest
                {
                    BankId = selectedBankId,
                    Amount = amount,
                    ChargeId = Guid.NewGuid().ToString(),
                    BankAccountName = bankAccountName.Trim(),
                    BankAccountNumber = bankAccountNumber.Trim(),
                    Email = string.IsNullOrWhiteSpace(email) ? null : email.Trim(),
                    FirstName = string.IsNullOrWhiteSpace(firstName) ? null : firstName.Trim(),
                    LastName = string.IsNullOrWhiteSpace(lastName) ? null : lastName.Trim()
                });

            if (!response.Success || response.Result?.Data?.Transaction is not { } data)
            {
                errorMessage = response.ErrorMessage ?? "PayChangu could not initiate the bank payout.";
                return;
            }

            chargeId = data.ChargeId;
            providerReference = data.ReferenceId;
            transactionStatus = data.Status;
            accountDetails = $"{data.RecipientAccountDetails.BankName} — {data.RecipientAccountDetails.AccountNumber} ({data.RecipientAccountDetails.AccountName})";
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Unable to connect to PayChangu: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GetBankPayoutDetailsAsync()
    {
        payoutDetailsMessage = null;
        payoutDetails = null;
        isLoadingPayoutDetails = true;
        try
        {
            var response = await payChanguClient.Payouts.Bank.GetDetailsAsync(chargeId!);
            if (!response.Success || response.Result?.Data is not { } data)
            {
                payoutDetailsSucceeded = false;
                payoutDetailsMessage = response.ErrorMessage ?? "Unable to retrieve bank payout details.";
                return;
            }

            payoutDetailsSucceeded = true;
            payoutDetailsMessage = "Bank payout details retrieved successfully.";
            payoutDetails =
                $"Charge ID: {data.ChargeId}\n" +
                $"Reference: {data.ReferenceId}\n" +
                $"Status: {data.Status}\n" +
                $"Amount: {data.Currency} {data.Amount:N2}\n" +
                $"Recipient: {data.RecipientAccountDetails.AccountName}\n" +
                $"Account: {data.RecipientAccountDetails.AccountNumber}\n" +
                $"Bank: {data.RecipientAccountDetails.BankName}\n" +
                $"Created: {data.CreatedAt:g}\n" +
                $"Completed: {data.CompletedAt?.ToString("g") ?? "Not completed"}";
        }
        catch (HttpRequestException ex)
        {
            payoutDetailsSucceeded = false;
            payoutDetailsMessage = $"Unable to retrieve bank payout details: {ex.Message}";
        }
        finally
        {
            isLoadingPayoutDetails = false;
        }
    }

    private async Task GetAllBankPayoutsAsync()
    {
        bankPayoutListMessage = null;
        bankPayouts.Clear();
        isLoadingBankPayouts = true;
        try
        {
            var response = await payChanguClient.Payouts.Bank.GetAllAsync();
            if (!response.Success || response.Result?.Data is not { } data)
            {
                bankPayoutListSucceeded = false;
                bankPayoutListMessage = response.ErrorMessage ?? "Unable to retrieve bank payout transactions.";
                return;
            }

            bankPayoutListSucceeded = true;
            bankPayouts.AddRange(data.Transactions);
            bankPayoutCurrentPage = data.CurrentPage;
            bankPayoutTotalPages = data.TotalPages;
            bankPayoutListMessage = bankPayouts.Count == 0
                ? "No bank payout transactions were returned on this page."
                : "Bank payout transactions retrieved successfully.";
        }
        catch (HttpRequestException ex)
        {
            bankPayoutListSucceeded = false;
            bankPayoutListMessage = $"Unable to retrieve bank payout transactions: {ex.Message}";
        }
        finally
        {
            isLoadingBankPayouts = false;
        }
    }
}
