@using Bogus

@page "/direct-charge/mobile-money"

<PageTitle>Mobile Money Direct Charge | PayChangu.NET Sample</PageTitle>

<RadzenStack Gap="1rem" class="sample-page">
    <div class="sample-page-header">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Direct Charge — Mobile Money</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">
            Request a payment from a customer's Mobile Money wallet.
        </RadzenText>
    </div>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenText TextStyle="TextStyle.Subtitle2">Amount</RadzenText>
                    <RadzenNumeric TValue="decimal" @bind-Value="amount" Min="1" Format="N2" Style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenText TextStyle="TextStyle.Subtitle2">Mobile Money operator</RadzenText>
                    <RadzenDropDown TValue="string" Data="@mobileMoneyOperators" TextProperty="Name" ValueProperty="RefId"
                                    @bind-Value="selectedOperatorRefId" Change="@OnOperatorChanged"
                                    Placeholder="Select an operator" Disabled="@isLoadingOperators" Style="width: 100%" />
                    <a href="/direct-charge/mobile-money/operators">View supported operators</a>
                    @if (isLoadingOperators)
                    {
                        <RadzenText TextStyle="TextStyle.Caption">Loading supported operators...</RadzenText>
                    }
                    else if (!string.IsNullOrWhiteSpace(operatorErrorMessage))
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Warning">@operatorErrorMessage</RadzenAlert>
                    }
                </RadzenColumn>
            </RadzenRow>
            <RadzenText TextStyle="TextStyle.Caption">
                The currency for Mobile Money Direct Charge is determined by the selected operator.
            </RadzenText>

            <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem;">
                <RadzenText TextStyle="TextStyle.Subtitle2">Customer details</RadzenText>
                <RadzenButton Text="Refresh details" Icon="refresh" Size="ButtonSize.Small" Click="@GenerateTestDetails" />
            </div>
            <RadzenText TextStyle="TextStyle.Caption">Generated values are editable. TNM and Airtel use the documented sandbox numbers.</RadzenText>
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenTextBox @bind-Value="mobile" Placeholder="Mobile number" Style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenTextBox @bind-Value="email" Placeholder="Email address (optional)" Style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenTextBox @bind-Value="firstName" Placeholder="First name (optional)" Style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenTextBox @bind-Value="lastName" Placeholder="Last name (optional)" Style="width: 100%" />
                </RadzenColumn>
            </RadzenRow>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger">@errorMessage</RadzenAlert>
            }
            <RadzenButton Text="Charge Mobile Money" Icon="payments" Click="@InitiateMobileMoneyDirectChargeAsync" Disabled="@isLoading" />
        </RadzenStack>
    </RadzenCard>

    @if (isLoading)
    {
        <RadzenCard><RadzenText TextStyle="TextStyle.Body2">Sending payment request to PayChangu...</RadzenText></RadzenCard>
    }
    else if (!string.IsNullOrWhiteSpace(chargeId))
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenAlert AlertStyle="AlertStyle.Info">
                    The Direct Charge request was accepted. This does not mean the customer has completed payment.
                    Verify the transaction or process its webhook before fulfilling an order.
                </RadzenAlert>
                <RadzenText TextStyle="TextStyle.Subtitle2">Charge identifier</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">@chargeId</RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle2">Provider reference</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">@providerReference</RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle2">Current status</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">@paymentStatus</RadzenText>
                <a href="/direct-charge/mobile-money/operators">View Mobile Money operators</a>
                <a href="/direct-charge/mobile-money/details?charge_id=@chargeId">Open Single Charge Details</a>
                <a href="/verify-transactions">Open Verify Transactions</a>
            </RadzenStack>
        </RadzenCard>
    }
</RadzenStack>

@code {
    [Inject] IPayChanguClient payChanguClient { get; set; } = default!;

    private readonly Faker faker = new();
    private readonly List<SupportedMobileMoneyOperator> mobileMoneyOperators = [];
    private decimal amount = 5000m;
    private string? selectedOperatorRefId;
    private string mobile = string.Empty;
    private string email = string.Empty;
    private string firstName = string.Empty;
    private string lastName = string.Empty;
    private string? chargeId;
    private string? providerReference;
    private string? paymentStatus;
    private string? errorMessage;
    private string? operatorErrorMessage;
    private bool isLoading;
    private bool isLoadingOperators;

    protected override async Task OnInitializedAsync()
    {
        await LoadMobileMoneyOperatorsAsync();
        GenerateTestDetails();
    }

    private void GenerateTestDetails()
    {
        firstName = faker.Name.FirstName();
        lastName = faker.Name.LastName();
        email = faker.Internet.Email();
        mobile = GetTestMobileNumber(selectedOperatorRefId);
    }

    private void OnOperatorChanged(object value)
    {
        selectedOperatorRefId = value?.ToString();
        mobile = GetTestMobileNumber(selectedOperatorRefId);
    }

    private string GetTestMobileNumber(string? operatorRefId)
    {
        var operatorName = mobileMoneyOperators.FirstOrDefault(x => x.RefId == operatorRefId)?.Name ?? string.Empty;
        if (operatorName.Contains("TNM", StringComparison.OrdinalIgnoreCase)) return "0888000000";
        if (operatorName.Contains("Airtel", StringComparison.OrdinalIgnoreCase)) return "0999000000";
        return faker.Random.ReplaceNumbers("09########");
    }

    private async Task LoadMobileMoneyOperatorsAsync()
    {
        isLoadingOperators = true;
        operatorErrorMessage = null;
        try
        {
            var response = await payChanguClient.ReferenceData.MobileMoneyOperators.GetAllAsync();
            if (response.Success && response.Result?.Data is { } operators)
            {
                mobileMoneyOperators.AddRange(operators);
                selectedOperatorRefId = mobileMoneyOperators.FirstOrDefault()?.RefId;
            }
            else
            {
                operatorErrorMessage = response.ErrorMessage ?? "Unable to retrieve supported Mobile Money operators.";
            }
        }
        catch (HttpRequestException ex)
        {
            operatorErrorMessage = $"Unable to retrieve Mobile Money operators: {ex.Message}";
        }
        finally
        {
            isLoadingOperators = false;
        }
    }

    private async Task InitiateMobileMoneyDirectChargeAsync()
    {
        errorMessage = null;
        chargeId = null;
        providerReference = null;
        paymentStatus = null;

        if (amount <= 0)
        {
            errorMessage = "Enter an amount greater than zero.";
            return;
        }
        if (string.IsNullOrWhiteSpace(mobile) || string.IsNullOrWhiteSpace(selectedOperatorRefId))
        {
            errorMessage = "Enter a mobile number and select a Mobile Money operator.";
            return;
        }

        isLoading = true;
        try
        {
            var response = await payChanguClient.DirectCharges.MobileMoney.InitiateAsync(
                new InitiateMobileMoneyDirectChargeRequest
                {
                    Mobile = mobile.Trim(),
                    MobileMoneyOperatorRefId = selectedOperatorRefId!,
                    Amount = amount,
                    ChargeId = Guid.NewGuid().ToString(),
                    Email = string.IsNullOrWhiteSpace(email) ? null : email.Trim(),
                    FirstName = string.IsNullOrWhiteSpace(firstName) ? null : firstName.Trim(),
                    LastName = string.IsNullOrWhiteSpace(lastName) ? null : lastName.Trim()
                });

            if (!response.Success || response.Result?.Data is not { } data)
            {
                errorMessage = response.ErrorMessage ?? "PayChangu could not initiate the Mobile Money Direct Charge.";
                return;
            }

            chargeId = data.ChargeId;
            providerReference = data.ReferenceId;
            paymentStatus = data.Status;
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Unable to connect to PayChangu: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }


}
