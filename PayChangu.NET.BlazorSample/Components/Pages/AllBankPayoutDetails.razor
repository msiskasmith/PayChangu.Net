@page "/payouts/bank/all"

<PageTitle>All Bank Payout Details | PayChangu.NET Sample</PageTitle>

<RadzenStack Gap="1rem" class="sample-page">
    <div class="sample-page-header">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">All Bank Payout Details</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">Retrieve the bank payout transactions returned on the current API page.</RadzenText>
    </div>
    <RadzenCard>
        <RadzenStack Gap="0.75rem">
            <RadzenButton Text="Get all bank payouts" Icon="refresh" Click="@GetAllAsync" Disabled="@isLoading" />
            @if (isLoading)
            {
                <RadzenText>Loading bank payouts...</RadzenText>
            }
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <RadzenAlert AlertStyle="@(succeeded ? AlertStyle.Success : AlertStyle.Warning)">@message</RadzenAlert>
            }
            @if (bankPayouts.Count > 0)
            {
                <RadzenText TextStyle="TextStyle.Caption">Page @currentPage of @totalPages — @bankPayouts.Count transaction(s)</RadzenText>
                @foreach (var payout in bankPayouts)
                {
                    <RadzenCard Variant="Variant.Outlined">
                        <RadzenStack Gap="0.25rem">
                            <RadzenText TextStyle="TextStyle.Subtitle2">@payout.ChargeId</RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2">@payout.Currency @payout.Amount.ToString("N2") — @payout.Status</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption">Reference: @payout.ReferenceId</RadzenText>
                        </RadzenStack>
                    </RadzenCard>
                }
            }
        </RadzenStack>
    </RadzenCard>
</RadzenStack>

@code {
    [Inject] IPayChanguClient payChanguClient { get; set; } = default!;
    private readonly List<BankPayoutTransaction> bankPayouts = [];
    private int currentPage;
    private int totalPages;
    private bool isLoading;
    private bool succeeded;
    private string? message;

    protected override Task OnInitializedAsync() => GetAllAsync();

    private async Task GetAllAsync()
    {
        message = null;
        bankPayouts.Clear();
        isLoading = true;
        try
        {
            var response = await payChanguClient.Payouts.Bank.GetAllAsync();
            if (!response.Success || response.Result?.Data is not { } data)
            {
                succeeded = false;
                message = response.ErrorMessage ?? "Unable to retrieve bank payout transactions.";
                return;
            }

            bankPayouts.AddRange(data.Transactions);
            currentPage = data.CurrentPage;
            totalPages = data.TotalPages;
            succeeded = true;
            message = bankPayouts.Count == 0
                ? "No bank payout transactions were returned on this page."
                : "Bank payout transactions retrieved successfully.";
        }
        catch (HttpRequestException ex)
        {
            succeeded = false;
            message = $"Unable to retrieve bank payout transactions: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
