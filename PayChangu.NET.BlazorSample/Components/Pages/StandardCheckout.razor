@using Bogus

@page "/standard-checkout"

<PageTitle>Standard Checkout | PayChangu.NET Sample</PageTitle>

<RadzenStack Gap="1rem" class="sample-page">
    <div class="sample-page-header">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Hosted Standard Checkout</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">
            Create a hosted checkout session and redirect the customer to PayChangu to complete payment.
        </RadzenText>
    </div>

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenText TextStyle="TextStyle.Subtitle2">Amount</RadzenText>
                    <RadzenNumeric TValue="decimal" @bind-Value="amount" Min="1" Format="N2" Style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenText TextStyle="TextStyle.Subtitle2">Currency</RadzenText>
                    <RadzenDropDown TValue="PayChanguCurrency" Data="@currencies" @bind-Value="currency" Style="width: 100%" />
                </RadzenColumn>
            </RadzenRow>

            <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem;">
                <RadzenText TextStyle="TextStyle.Subtitle2">Customer details</RadzenText>
                <RadzenButton Text="Refresh details" Icon="refresh" Size="ButtonSize.Small" Click="@GenerateTestDetails" />
            </div>
            <RadzenText TextStyle="TextStyle.Caption">Generated values are editable. Refresh to generate another set.</RadzenText>
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenTextBox @bind-Value="firstName" Placeholder="First name" Style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenTextBox @bind-Value="lastName" Placeholder="Last name" Style="width: 100%" />
                </RadzenColumn>
                <RadzenColumn Size="12">
                    <RadzenTextBox @bind-Value="email" Placeholder="Email address" Style="width: 100%" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenText TextStyle="TextStyle.Subtitle2">Checkout URLs</RadzenText>
            <RadzenTextBox @bind-Value="callbackUrl" Placeholder="Callback URL" Style="width: 100%" />
            <RadzenTextBox @bind-Value="returnUrl" Placeholder="Return URL" Style="width: 100%" />
            <RadzenText TextStyle="TextStyle.Caption">Use publicly accessible URLs belonging to your application.</RadzenText>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger">@errorMessage</RadzenAlert>
            }

            <RadzenButton Text="Initiate checkout" Icon="payments" Click="@InitiateCheckoutAsync" Disabled="@isLoading" />
        </RadzenStack>
    </RadzenCard>

    @if (isLoading)
    {
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.Body2">Creating checkout session with PayChangu...</RadzenText>
        </RadzenCard>
    }
    else if (!string.IsNullOrWhiteSpace(checkoutUrl))
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenAlert AlertStyle="AlertStyle.Success">
                    Checkout session created. The customer must complete payment on PayChangu.
                </RadzenAlert>
                <RadzenText TextStyle="TextStyle.Subtitle2">Transaction reference</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">@transactionIdentifier</RadzenText>
                <a href="@checkoutUrl" target="_blank" rel="noopener noreferrer">Open PayChangu checkout</a>
                <a href="/verify-transactions">Verify transaction</a>
            </RadzenStack>
        </RadzenCard>
    }
</RadzenStack>

@code {
    [Inject] IPayChanguClient payChanguClient { get; set; } = default!;

    private readonly Faker faker = new();
    private readonly PayChanguCurrency[] currencies = Enum.GetValues<PayChanguCurrency>();

    private PayChanguCurrency currency = PayChanguCurrency.MWK;
    private decimal amount = 5000m;
    private string firstName = string.Empty;
    private string lastName = string.Empty;
    private string email = string.Empty;
    private string callbackUrl = "https://example.com/payments/callback";
    private string returnUrl = "https://example.com/payments/return";
    private string? checkoutUrl;
    private string? transactionIdentifier;
    private string? errorMessage;
    private bool isLoading;

    protected override void OnInitialized()
    {
        GenerateTestDetails();
    }

    private void GenerateTestDetails()
    {
        firstName = faker.Name.FirstName();
        lastName = faker.Name.LastName();
        email = faker.Internet.Email();
    }

    private async Task InitiateCheckoutAsync()
    {
        errorMessage = null;
        checkoutUrl = null;
        transactionIdentifier = null;

        if (amount <= 0)
        {
            errorMessage = "Enter an amount greater than zero.";
            return;
        }

        if (string.IsNullOrWhiteSpace(firstName) ||
            string.IsNullOrWhiteSpace(lastName) ||
            string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(callbackUrl) ||
            string.IsNullOrWhiteSpace(returnUrl))
        {
            errorMessage = "Complete the customer details and checkout URLs.";
            return;
        }

        isLoading = true;

        try
        {
            var response = await payChanguClient.Checkout.InitiateAsync(
                new InitiateCheckoutRequest
                {
                    Amount = amount,
                    Currency = currency,
                    Email = email.Trim(),
                    FirstName = firstName.Trim(),
                    LastName = lastName.Trim(),
                    TransactionReference = Guid.NewGuid().ToString(),
                    CallbackUrl = callbackUrl.Trim(),
                    ReturnUrl = returnUrl.Trim(),
                    Customization = new PaymentCustomization
                    {
                        Title = "Sample payment",
                        Description = "PayChangu.NET Blazor sample payment"
                    }
                });

            if (!response.Success || response.Result?.Data is not { } data)
            {
                errorMessage = response.ErrorMessage ?? "PayChangu could not initiate the checkout session.";
                return;
            }

            transactionIdentifier = data.Session.TransactionReference;
            checkoutUrl = data.CheckoutUrl;
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Unable to connect to PayChangu: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
