@page "/payouts/banks"

<PageTitle>Get Banks | PayChangu.NET Sample</PageTitle>

<RadzenStack Gap="1rem" class="sample-page">
    <div class="sample-page-header">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Get Banks</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1">Retrieve the banks and payout providers supported for a selected currency.</RadzenText>
    </div>
    <RadzenCard>
        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.Subtitle2">Currency</RadzenText>
            <RadzenDropDown TValue="PayChanguCurrency" Data="@currencies" @bind-Value="currency"
                            Change="@OnCurrencyChanged" Style="width: 100%" />
            <RadzenButton Text="Get banks" Icon="refresh" Click="@LoadBanksAsync" Disabled="@isLoading" />
            @if (isLoading)
            {
                <RadzenText>Loading supported banks...</RadzenText>
            }
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <RadzenAlert AlertStyle="@(succeeded ? AlertStyle.Success : AlertStyle.Warning)">@message</RadzenAlert>
            }
            @foreach (var bank in banks)
            {
                <RadzenCard Variant="Variant.Outlined">
                    <RadzenStack Gap="0.25rem">
                        <RadzenText TextStyle="TextStyle.Subtitle2">@bank.Name</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption">Bank ID: @bank.Id</RadzenText>
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenStack>
    </RadzenCard>
</RadzenStack>

@code {
    [Inject] IPayChanguClient payChanguClient { get; set; } = default!;
    private readonly PayChanguCurrency[] currencies = Enum.GetValues<PayChanguCurrency>();
    private readonly List<SupportedBank> banks = [];
    private PayChanguCurrency currency = PayChanguCurrency.MWK;
    private bool isLoading;
    private bool succeeded;
    private string? message;

    protected override Task OnInitializedAsync() => LoadBanksAsync();

    private async Task OnCurrencyChanged(object value)
    {
        currency = (PayChanguCurrency)value;
        await LoadBanksAsync();
    }

    private async Task LoadBanksAsync()
    {
        isLoading = true;
        message = null;
        banks.Clear();
        try
        {
            var response = await payChanguClient.ReferenceData.Banks.GetSupportedAsync(currency);
            if (!response.Success || response.Result?.Data is not { } data)
            {
                succeeded = false;
                message = response.ErrorMessage ?? $"Unable to retrieve supported banks for {currency}.";
                return;
            }
            banks.AddRange(data);
            succeeded = true;
            message = $"{banks.Count} bank or payout provider(s) retrieved.";
        }
        catch (HttpRequestException ex)
        {
            succeeded = false;
            message = $"Unable to retrieve supported banks: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
