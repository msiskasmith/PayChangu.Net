 <RadzenCard>
    <RadzenStack Gap="0.75rem">
        <RadzenText TextStyle="TextStyle.H6">PayChangu API key not configured</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2">
            The sample application has started, but the PayChangu API examples are unavailable until
            you configure your API secret key. Use .NET User Secrets to keep the key out of source control.
        </RadzenText>
        <RadzenText TextStyle="TextStyle.Body2">
            Open a terminal in the <code>PayChangu.NET.BlazorSample</code> project directory and run:
        </RadzenText>
        <RadzenAlert AlertStyle="AlertStyle.Dark"
                     ShowIcon="false"
                     AllowClose="false"
                     Variant="Variant.Flat"
                     Style="background-color: #1e1e1e; color: #ffffff; border-color: #1e1e1e;">
            <pre style="margin: 0; overflow-x: auto; color: inherit;"><code style="color: inherit; font-family: Consolas, 'Courier New', monospace;">dotnet user-secrets set "PayChangu:SecretKey" "&lt;your-paychangu-secret-key&gt;"</code></pre>
        </RadzenAlert>
        <RadzenText TextStyle="TextStyle.Body2">
            After saving the secret, restart the sample application. This notice will disappear and
            the examples will become available.
        </RadzenText>
    </RadzenStack>
</RadzenCard>
