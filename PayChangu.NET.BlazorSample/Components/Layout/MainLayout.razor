@inherits LayoutComponentBase

<RadzenComponents @rendermode="InteractiveAuto" />

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     Gap="1rem"
                     class="rz-px-4">
            <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
            <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">
                PayChangu.NET
            </RadzenText>
            <RadzenBadge Text="Sample application" BadgeStyle="BadgeStyle.Info" />
        </RadzenStack>
    </RadzenHeader>

    <RadzenSidebar @bind-Expanded="sidebarExpanded">
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Overview" Icon="dashboard" Path="/" />
            <RadzenPanelMenuItem Text="Payment flows" Icon="payments" Path="/payment-flows" />
            <RadzenPanelMenuItem Text="Transactions" Icon="receipt_long" Path="/transactions" />
            <RadzenPanelMenuItem Text="Wallet balance" Icon="account_balance_wallet" Path="/wallet" />
            <RadzenPanelMenuItem Text="Payouts" Icon="send" Disabled="true" />
            <RadzenPanelMenuItem Text="Webhooks" Icon="webhook" Disabled="true" />
        </RadzenPanelMenu>
    </RadzenSidebar>

    <RadzenBody>
        <main class="rz-p-4 rz-p-md-6">
            @Body
        </main>
    </RadzenBody>

    <RadzenFooter>
        <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">
            PayChangu.NET sample application
        </RadzenText>
    </RadzenFooter>
</RadzenLayout>

@code {
    private bool sidebarExpanded = true;
}
