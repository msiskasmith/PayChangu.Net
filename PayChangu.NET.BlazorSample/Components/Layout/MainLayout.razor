@inherits LayoutComponentBase
@inject IConfiguration Configuration

<RadzenComponents @rendermode="InteractiveAuto" />

<RadzenLayout>
    <RadzenHeader class="sample-header">
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     Gap="1rem"
                     class="rz-px-4 sample-header-content">
            <RadzenSidebarToggle class="me-0" Click="@(() => sidebarExpanded = !sidebarExpanded)" />
            <RadzenIcon Icon="payments" class="sample-brand-icon" />
            <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">
                PayChangu.NET
            </RadzenText>
            <RadzenBadge Text="Sample application" BadgeStyle="BadgeStyle.Info" />
        </RadzenStack>
    </RadzenHeader>

    <RadzenSidebar @bind-Expanded="sidebarExpanded" class="sample-sidebar">
        <RadzenPanelMenu class="sample-navigation">
            <RadzenPanelMenuItem Text="Getting Started" Icon="dashboard">
                <RadzenPanelMenuItem Text="Overview" Path="/" />
                <RadzenPanelMenuItem Text="Balance" Path="/wallet" />
            </RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="Hosted Standard Checkout" Icon="shopping_cart">
                <RadzenPanelMenuItem Text="Initiate Transaction" Path="/standard-checkout" />
            </RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="Verify Transactions" Icon="receipt_long" Path="/verify-transactions" />
            <RadzenPanelMenuItem Text="Direct Charge MoMo" Icon="phone_android">
                <RadzenPanelMenuItem Text="Mobile Money Operators" Path="/direct-charge/mobile-money/operators" />
                <RadzenPanelMenuItem Text="Charge Mobile Money" Path="/direct-charge/mobile-money" />
                <RadzenPanelMenuItem Text="Single Charge Details" Path="/direct-charge/mobile-money/details" />
            </RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="Direct Charge Bank Transfer" Icon="account_balance">
                <RadzenPanelMenuItem Text="Bank Transfer" Path="/direct-charge/bank-transfer" />
                <RadzenPanelMenuItem Text="Single Transaction" Path="/direct-charge/bank-transfer/details" />
            </RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="Direct Card" Icon="credit_card">
                <RadzenPanelMenuItem Text="Charge a card" Path="/direct-charge/card" />
                <RadzenPanelMenuItem Text="Refund card charge" Path="/direct-charge/card/refund" />
            </RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="Payout" Icon="send">
                <RadzenPanelMenuItem Text="Get Operators" Path="/payouts/operators" />
                <RadzenPanelMenuItem Text="Mobile Money Payout" Path="/payouts/mobile-money" />
                <RadzenPanelMenuItem Text="Get Banks" Path="/payouts/banks" />
                <RadzenPanelMenuItem Text="Bank Payout" Path="/payouts/bank" />
                <RadzenPanelMenuItem Text="Single Bank Payout Details" Path="/payouts/bank/details" />
                <RadzenPanelMenuItem Text="All Bank Payout Details" Path="/payouts/bank/all" />
            </RadzenPanelMenuItem>
            <RadzenPanelMenuItem Text="Webhooks" Icon="webhook" Path="/webhooks" />
        </RadzenPanelMenu>
    </RadzenSidebar>

    <RadzenBody class="sample-body">
        <main class="rz-p-4 rz-p-md-6 sample-main">
            @if (string.IsNullOrWhiteSpace(Configuration["PayChangu:SecretKey"]))
            {
                <PayChanguConfigurationNotice />
            }
            else
            {
                @Body
            }
        </main>
    </RadzenBody>

    <RadzenFooter class="sample-footer">
        <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">
            PayChangu.NET sample application
        </RadzenText>
    </RadzenFooter>
</RadzenLayout>

@code {
    private bool sidebarExpanded = true;
}
