@using System.Collections
@using System.Globalization
@using System.Reflection
@using PayChangu.NET.BlazorSample.Services
@inject WebhookEventStore EventStore

@if (isLoading)
{
    <div class="webhook-details-skeleton" aria-busy="true" aria-label="Loading webhook event">
        <div class="skeleton-heading"></div>
        <div class="skeleton-grid">
            @for (var i = 0; i < 6; i++)
            {
                <div class="skeleton-field">
                    <div class="skeleton-label"></div>
                    <div class="skeleton-value"></div>
                </div>
            }
        </div>
    </div>
}
else if (webhookEvent is null)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat">
        The webhook event could not be found. It may have been cleared from the event store.
    </RadzenAlert>
}
else if (properties.Count == 0)
{
    <RadzenText TextStyle="TextStyle.Body2">No webhook event properties are available.</RadzenText>
}
else
{
    <div class="webhook-event-details">
        <RadzenText TextStyle="TextStyle.Subtitle2" class="details-heading">Webhook event payload</RadzenText>
        <RadzenRow Gap="0.75rem">
            @foreach (var property in properties)
            {
                <RadzenColumn Size="12" SizeSM="6" SizeLG="4">
                    <div class="webhook-property">
                        <RadzenText TextStyle="TextStyle.Caption" class="property-name">
                            @property.Name
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" class="property-value">
                            @property.Value
                        </RadzenText>
                    </div>
                </RadzenColumn>
            }
        </RadzenRow>
    </div>
}

@code {
    /// <summary>
    /// Gets or sets the webhook event to display. When supplied, this takes precedence over EventId.
    /// </summary>
    [Parameter]
    public PayChanguWebhookEvent? Event { get; set; }

    /// <summary>
    /// Gets or sets the identifier of a webhook event stored in WebhookEventStore.
    /// </summary>
    [Parameter]
    public Guid? EventId { get; set; }

    private PayChanguWebhookEvent? webhookEvent;
    private List<WebhookProperty> properties = [];
    private bool isLoading;

    protected override async Task OnParametersSetAsync()
    {
        if (Event is not null)
        {
            webhookEvent = Event;
            isLoading = false;
        }
        else if (EventId.HasValue)
        {
            isLoading = true;
            webhookEvent = null;
            properties.Clear();

            // Yield once so the loading skeleton can render before the store lookup completes.
            await Task.Yield();

            // The webhook may arrive before its event has been added to the in-memory store.
            // Retry three times, waiting two seconds between attempts (up to six seconds).
            for (var attempt = 0; attempt <= 3; attempt++)
            {
                webhookEvent = EventStore.GetEvent(EventId.Value)?.WebhookEvent;

                if (webhookEvent is not null || attempt == 3)
                    break;

                await Task.Delay(TimeSpan.FromSeconds(2));
            }

            isLoading = false;
        }
        else
        {
            webhookEvent = null;
            isLoading = false;
        }

        properties = webhookEvent is null
            ? []
            : GetProperties(webhookEvent);
    }

    private static List<WebhookProperty> GetProperties(object instance)
    {
        var result = new List<WebhookProperty>();
        var visited = new HashSet<object>(ReferenceEqualityComparer.Instance);

        AddProperties(instance, string.Empty, result, visited, 0);

        return result;
    }

    private static void AddProperties(
        object instance,
        string prefix,
        ICollection<WebhookProperty> result,
        ISet<object> visited,
        int depth)
    {
        if (depth > 5 || !visited.Add(instance))
            return;

        var instanceType = instance.GetType();

        foreach (var propertyInfo in instanceType.GetProperties(BindingFlags.Instance | BindingFlags.Public))
        {
            if (!propertyInfo.CanRead || propertyInfo.GetIndexParameters().Length != 0)
                continue;

            object? value;

            try
            {
                value = propertyInfo.GetValue(instance);
            }
            catch
            {
                // A computed property may not be available for an incomplete webhook payload.
                continue;
            }

            if (value is null)
                continue;

            var propertyName = string.IsNullOrEmpty(prefix)
                ? FormatPropertyName(propertyInfo.Name)
                : $"{prefix} / {FormatPropertyName(propertyInfo.Name)}";

            if (IsSimpleValue(value.GetType()))
            {
                result.Add(new WebhookProperty(propertyName, FormatValue(value)));
            }
            else if (value is IEnumerable collection && value is not string)
            {
                var index = 0;

                foreach (var item in collection)
                {
                    if (item is null)
                    {
                        index++;
                        continue;
                    }

                    var itemName = $"{propertyName} [{index}]";

                    if (IsSimpleValue(item.GetType()))
                        result.Add(new WebhookProperty(itemName, FormatValue(item)));
                    else
                        AddProperties(item, itemName, result, visited, depth + 1);

                    index++;
                }
            }
            else
            {
                AddProperties(value, propertyName, result, visited, depth + 1);
            }
        }

        visited.Remove(instance);
    }

    private static bool IsSimpleValue(Type type)
    {
        type = Nullable.GetUnderlyingType(type) ?? type;

        return type.IsPrimitive
            || type.IsEnum
            || type == typeof(string)
            || type == typeof(decimal)
            || type == typeof(Guid)
            || type == typeof(DateTime)
            || type == typeof(DateTimeOffset)
            || type == typeof(TimeSpan);
    }

    private static string FormatValue(object value)
    {
        return value switch
        {
            DateTime dateTime => dateTime.ToString("g", CultureInfo.CurrentCulture),
            DateTimeOffset dateTimeOffset => dateTimeOffset.ToLocalTime().ToString("g", CultureInfo.CurrentCulture),
            bool boolean => boolean ? "Yes" : "No",
            IFormattable formattable => formattable.ToString(null, CultureInfo.InvariantCulture) ?? string.Empty,
            _ => value.ToString() ?? string.Empty
        };
    }

    private static string FormatPropertyName(string name)
    {
        return string.Concat(name.Select((character, index) =>
            index > 0 && char.IsUpper(character) ? $" {character}" : character.ToString()));
    }

    private sealed record WebhookProperty(string Name, string Value);
}
