<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>11.0</LangVersion>
		<!-- Enforce deterministic output mapping -->
		<Deterministic>true</Deterministic>

		<!-- Force deterministic path formatting ONLY when building on CI -->
		<!-- (Enabling this locally breaks local Visual Studio debugging) -->
		<ContinuousIntegrationBuild Condition="'$(TF_BUILD)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true' Or '$(CI)' == 'true'">true</ContinuousIntegrationBuild>

		<!-- Embed untracked compiler-generated files (like AssemblyInfo) into the PDB -->
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>

		<!-- NuGet Package Metadata -->
		<PackageId>PayChangu.NET</PackageId>
		<Version>0.2.9</Version>
		<Description>A strongly typed .NET SDK for integrating with the PayChangu payment gateway, supporting Standard Checkout, Direct Charges, transaction verification, payouts, wallet balances, and webhook signature validation.</Description>
		<PackageTags>PayChangu;Payments;Malawi;PaymentGateway;Checkout;DirectCharge;MobileMoney;BankTransfer;Payout;Webhooks;DotNet</PackageTags>

		<Authors>PayChangu.NET Contributors</Authors>
		<Company>Community</Company>
		<Copyright>Copyright © 2026 PayChangu.NET Contributors</Copyright>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

		<!-- Repository Metadata -->
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/msiskasmith/PayChangu.NET</RepositoryUrl>
		<PackageProjectUrl>https://github.com/msiskasmith/PayChangu.NET</PackageProjectUrl>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		
		<!-- Documentation -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- Package Configuration -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
		<PackageReference Include="System.Text.Json" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="PayChangu.NET.Tests" />
	</ItemGroup>

</Project>
